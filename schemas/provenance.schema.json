{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/provenance.schema.json",
  "title": "Atlas Artifact Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "generated_at", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "atlas_id": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "kind", "license", "source_ids"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "#/$defs/sha256" },
          "kind": { "enum": ["source", "document", "test-report", "benchmark", "capture", "skill-eval", "generated", "sbom"] },
          "license": { "type": "string", "minLength": 2 },
          "source_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } },
          "generated_by": { "type": "string", "minLength": 2 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "path": { "type": "string", "pattern": "^[^/].*" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
