{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/akaitigo/reference-atlas-core/schemas/definitive-certificate.schema.json",
  "title":"Subject Definitive Certificate v2",
  "type":"object","additionalProperties":false,
  "required":["schema_version","completion_class","atlas_id","atlas_release","coverage_epoch","authority_lock_digest","authority_extraction_digest","authority_body_inventory_digest","authority_body_review_digest","surface_inventory_digest","verification_matrix_digest","scenario_proof_digest","scenario_closure_plan_digest","evidence_durability_digest","evidence_dependency_digest","depth_parity_digest","proof_graph_digest","skill_eval_digest","reference_system_digest","non_regression_digest","historical_certificates","issued_at","commit","signature"],
  "properties":{
    "schema_version":{"const":2},"completion_class":{"const":"subject-definitive"},"atlas_id":{"$ref":"#/$defs/id"},"atlas_release":{"type":"string","pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},"coverage_epoch":{"$ref":"#/$defs/date"},"authority_lock_digest":{"$ref":"#/$defs/sha256"},
    "authority_extraction_digest":{"$ref":"#/$defs/sha256"},"authority_body_inventory_digest":{"$ref":"#/$defs/sha256"},"authority_body_review_digest":{"$ref":"#/$defs/sha256"},"surface_inventory_digest":{"$ref":"#/$defs/sha256"},"verification_matrix_digest":{"$ref":"#/$defs/sha256"},"scenario_proof_digest":{"$ref":"#/$defs/sha256"},"scenario_closure_plan_digest":{"$ref":"#/$defs/sha256"},"evidence_durability_digest":{"$ref":"#/$defs/sha256"},"evidence_dependency_digest":{"$ref":"#/$defs/sha256"},"depth_parity_digest":{"$ref":"#/$defs/sha256"},"proof_graph_digest":{"$ref":"#/$defs/sha256"},"skill_eval_digest":{"$ref":"#/$defs/sha256"},"reference_system_digest":{"$ref":"#/$defs/sha256"},"non_regression_digest":{"$ref":"#/$defs/sha256"},
    "historical_certificates":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","classification","digest"],"properties":{"path":{"type":"string","pattern":"^evidence/history/.+/completion-certificate\\.json$"},"classification":{"const":"bounded-complete"},"digest":{"$ref":"#/$defs/sha256"}}}},
    "issued_at":{"type":"string","format":"date-time"},"commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"signature":{"type":"object","additionalProperties":false,"required":["type","digest"],"properties":{"type":{"const":"payload-sha256"},"digest":{"$ref":"#/$defs/sha256"}}}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}
}
