{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-body-document.schema.json",
  "title": "Subject-neutral Authority Body Candidate Anchor Document", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_ids", "locked_body_digest", "fetch", "extraction", "anchors"],
  "properties": {
    "schema_version": {"const": 1}, "document_id": {"type": "string", "pattern": "^document-[a-z0-9-]+$"}, "fetch_url": {"type": "string", "format": "uri"}, "authority_url": {"type": "string", "format": "uri"}, "document_locator": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "locked_source_digest": {"$ref": "#/$defs/sha256"}, "locked_body_digest": {"$ref": "#/$defs/sha256"},
    "fetch": {"type": "object", "additionalProperties": false, "required": ["status", "fetched_digest", "locked_digest_match", "error_digest"], "properties": {"status": {"enum": ["matched", "stale", "failed"]}, "fetched_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "locked_digest_match": {"type": "boolean"}, "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "final_url": {"anyOf": [{"type": "string", "format": "uri"}, {"type": "null"}]}, "content_type": {"type": ["string", "null"], "maxLength": 255}, "fetched_bytes": {"type": ["integer", "null"], "minimum": 0}, "error_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]} }},
    "extraction": {"type": "object", "additionalProperties": false, "required": ["method", "tool", "tool_digest", "selector_contract", "selector_exhaustive_for_locked_body", "authority_semantics_exhaustive", "review_status", "body_storage"], "properties": {"method": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"}, "tool": {"type": "string", "minLength": 2}, "tool_digest": {"$ref": "#/$defs/sha256"}, "selector_contract": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}, "selector_exhaustive_for_locked_body": {"type": "boolean"}, "authority_semantics_exhaustive": {"const": false}, "review_status": {"const": "automated-unreviewed"}, "body_storage": {"enum": ["digest-locator-and-offset-only", "digest-locator-and-metadata-only"]} }},
    "anchors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "locator", "locator_kind", "parent_anchor_id", "context_start", "context_end", "context_unit", "context_digest", "classification_status", "surface_ids"], "properties": {
      "id": {"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}, "locator": {"type": "string", "minLength": 1, "maxLength": 4096}, "locator_kind": {"enum": ["document-root", "fragment", "locked-body-offset", "source-member"]},
      "raw_selector": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "element_name": {"type": "string", "pattern": "^[A-Za-z0-9:_-]+$"}, "semantic_kind": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "tag": {"type": "string", "pattern": "^[A-Za-z0-9:_-]+$"}, "heading_level": {"type": ["integer", "null"], "minimum": 1, "maximum": 99}, "label_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
      "parent_anchor_id": {"anyOf": [{"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}, {"type": "null"}]}, "context_start": {"type": "integer", "minimum": 0}, "context_end": {"type": "integer", "minimum": 1}, "context_unit": {"enum": ["byte", "utf16-code-unit", "unicode-code-point"]}, "context_digest": {"$ref": "#/$defs/sha256"}, "classification_status": {"const": "pending-human"}, "surface_ids": {"type": "array", "maxItems": 0}, "behavior_ids": {"type": "array", "maxItems": 0}
    }, "anyOf": [{"required": ["raw_selector", "element_name"]}, {"required": ["semantic_kind", "tag", "heading_level", "label_digest"]}]}}
  },
  "anyOf": [{"required": ["fetch_url"], "not": {"anyOf": [{"required": ["authority_url"]}, {"required": ["document_locator"]}, {"required": ["locked_source_digest"]}]}}, {"required": ["authority_url", "document_locator", "locked_source_digest"]}],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
