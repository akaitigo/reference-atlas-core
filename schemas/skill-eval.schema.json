{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/skill-eval.schema.json",
  "title": "Atlas Skill Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "atlas_id", "atlas_release", "skill_id", "generated_at", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/dottedId" },
    "atlas_id": { "$ref": "#/$defs/id" },
    "atlas_release": { "$ref": "#/$defs/version" },
    "skill_id": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "result", "assertion"],
        "properties": {
          "id": { "$ref": "#/$defs/dottedId" },
          "category": { "enum": ["routing", "near-neighbor", "coverage-gap", "lifecycle", "authority", "execution", "authorization", "security"] },
          "result": { "enum": ["pass", "fail", "inconclusive"] },
          "assertion": { "type": "string", "minLength": 15 },
          "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
