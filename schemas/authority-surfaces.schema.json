{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-surfaces.schema.json",
  "title": "Authority Derived Surface Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_digest", "extraction", "surfaces"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_id": { "$ref": "#/$defs/dottedId" },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tool", "reviewed_by", "reviewed_at"],
      "properties": {
        "method": { "enum": ["machine-readable-primary", "primary-text-reviewed"] },
        "tool": { "type": "string", "minLength": 2 },
        "reviewed_by": { "type": "string", "minLength": 2 },
        "reviewed_at": { "$ref": "#/$defs/date" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator", "kind", "capability_id", "behavior_id", "title", "surface_ids"],
        "properties": {
          "id": { "$ref": "#/$defs/dottedId" },
          "locator": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["behavior", "capability"] },
          "capability_id": { "$ref": "#/$defs/dottedId" },
          "behavior_id": { "$ref": "#/$defs/dottedId" },
          "variant_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } },
          "title": { "type": "string", "minLength": 2 },
          "surface_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } }
        }
      }
    }
  },
  "$defs": {
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "surface": { "enum": ["orientation-scope", "foundations-mechanics", "architecture-design", "implementation-construction", "testing-verification", "failure-recovery", "operations-observability", "security-privacy-safety", "performance-capacity-cost", "compatibility-integration", "migration-evolution-deprecation", "decision-comparison", "provenance-rights", "agent-skill"] }
  }
}
