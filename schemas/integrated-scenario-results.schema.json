{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/integrated-scenario-results.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "created_at", "status", "command", "profile", "counts", "duration_ms", "source_digest", "harness_digest", "environment", "trace_contract", "completion_limits", "tests"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "minLength": 3}, "created_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["passed", "failed"]}, "command": {"type": "string", "minLength": 3}, "profile": {"type": "string", "minLength": 3}, "counts": {"type": "object", "additionalProperties": false, "required": ["total", "passed", "failed", "flaky", "skipped"], "properties": {"total": {"const": 10}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "flaky": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}}, "duration_ms": {"type": "number", "exclusiveMinimum": 0}, "source_digest": {"$ref": "#/$defs/sha256"}, "harness_digest": {"$ref": "#/$defs/sha256"}, "environment": {"type": "object", "minProperties": 8}, "trace_contract": {"type": "object", "additionalProperties": false, "required": ["per_scenario", "required_streams", "console_events"], "properties": {"per_scenario": {"const": true}, "required_streams": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["action", "network", "resource"]}}, "console_events": {"type": "string", "minLength": 3}}}, "completion_limits": {"type": "array", "items": {"type": "string", "minLength": 20}}, "tests": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "scenario", "title", "file", "line", "outcome", "attempts", "duration_ms", "final_status", "error", "trace", "screenshot"], "properties": {"id": {"type": "string", "minLength": 3}, "scenario": {"$ref": "#/$defs/scenario"}, "title": {"type": "string", "minLength": 3}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "outcome": {"type": "string", "minLength": 1}, "attempts": {"type": "integer", "minimum": 1}, "duration_ms": {"type": "number", "minimum": 0}, "final_status": {"enum": ["passed", "failed", "skipped", "flaky"]}, "error": {"type": ["string", "null"]}, "trace": {"$ref": "#/$defs/artifact"}, "screenshot": {"$ref": "#/$defs/artifact"}}}}},
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "scenario": {"enum": ["normal", "boundary", "refusal", "failure", "recovery", "migration", "operations", "security", "performance", "compatibility"]}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "action_stream": {"type": "boolean"}, "network_stream": {"type": "boolean"}, "resource_stream": {"type": "boolean"}}}}
}
