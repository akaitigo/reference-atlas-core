{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-body-inventory.schema.json", "title": "Subject-neutral Authority Body Candidate Anchor Denominator", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "generated_at", "status", "input_digest", "tool_digest", "body_storage", "selector_contract", "summary", "documents"],
  "properties": {
    "schema_version": {"const": 1}, "atlas_id": {"$ref": "#/$defs/id"}, "generated_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["incomplete-human-review-required", "incomplete-source-state"]}, "input_digest": {"$ref": "#/$defs/sha256"}, "tool_digest": {"$ref": "#/$defs/sha256"}, "body_storage": {"enum": ["digest-locator-and-offset-only", "digest-locator-and-metadata-only"]}, "selector_contract": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "reference_design": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "absolute_counts_transplanted"], "properties": {"repository": {"type": "string", "minLength": 2}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "absolute_counts_transplanted": {"const": false}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["source_entries", "unique_documents", "matched_documents", "stale_documents", "failed_documents", "selector_exhaustive_documents", "human_reviewed_anchors", "authority_semantics_exhaustive"], "properties": {
      "source_entries": {"type": "integer", "minimum": 1}, "unique_documents": {"type": "integer", "minimum": 1}, "matched_documents": {"type": "integer", "minimum": 0}, "stale_documents": {"type": "integer", "minimum": 0}, "failed_documents": {"type": "integer", "minimum": 0}, "selector_exhaustive_documents": {"type": "integer", "minimum": 0},
      "anchors": {"type": "integer", "minimum": 0}, "raw_anchor_candidates": {"type": "integer", "minimum": 0}, "anchors_by_kind": {"$ref": "#/$defs/counts"}, "anchors_by_selector": {"$ref": "#/$defs/counts"}, "classified_anchors": {"type": "integer", "minimum": 0}, "unclassified_anchors": {"type": "integer", "minimum": 0}, "pending_human_anchors": {"type": "integer", "minimum": 0}, "human_reviewed_anchors": {"type": "integer", "minimum": 0}, "core_v2_eligible_artifacts": {"type": "integer", "minimum": 0}, "promoted_surface_artifacts": {"type": "integer", "minimum": 0}, "promoted_atomic_behaviors": {"type": "integer", "minimum": 0}, "authority_semantics_exhaustive": {"type": "boolean"}, "denominator_closed": {"type": "boolean"}, "postgresql_authority_denominator_closed": {"type": "boolean", "$comment": "Compatibility alias; use denominator_closed for new Subjects."}
    }, "anyOf": [{"required": ["anchors", "anchors_by_kind", "classified_anchors", "unclassified_anchors", "core_v2_eligible_artifacts"]}, {"required": ["raw_anchor_candidates", "anchors_by_selector", "pending_human_anchors", "promoted_surface_artifacts"]}]},
    "documents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "digest", "fetch_status", "source_entries", "anchors"], "properties": {"id": {"type": "string", "pattern": "^document-[a-z0-9-]+$"}, "path": {"type": "string", "pattern": "^authority/body-inventory-draft/document-[a-z0-9-]+\\.json$"}, "digest": {"$ref": "#/$defs/sha256"}, "fetch_status": {"enum": ["matched", "stale", "failed"]}, "source_entries": {"type": "integer", "minimum": 1}, "anchors": {"type": "integer", "minimum": 0}, "anchors_by_kind": {"$ref": "#/$defs/counts"}, "anchors_by_selector": {"$ref": "#/$defs/counts"}}, "anyOf": [{"required": ["anchors_by_kind"]}, {"required": ["anchors_by_selector"]}]}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "counts": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "additionalProperties": {"type": "integer", "minimum": 1}}}
}
