{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/non-regression.schema.json",
  "title": "Definitive Non Regression Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "baseline", "replacements"],
  "properties": {
    "schema_version": {"const": 2},
    "atlas_id": {"$ref": "#/$defs/id"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^baselines/.+\\.json$"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection", "old_id", "new_ids", "equivalence", "reason", "execution_proof_evidence_ids", "migration_evidence_ids"],
        "properties": {
          "collection": {"enum": ["tests_labs", "target_sets", "targets", "claims", "proof_obligations", "evidence", "sources", "skill_eval_cases", "required_profiles", "matrix_rows", "depth_parity_rows", "ci_jobs"]},
          "old_id": {"type": "string", "minLength": 1},
          "new_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "equivalence": {"const": "equal-or-stronger"},
          "reason": {"type": "string", "minLength": 20},
          "execution_proof_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}},
          "migration_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dottedId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
