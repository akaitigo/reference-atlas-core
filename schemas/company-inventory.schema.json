{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/company-inventory.schema.json",
  "title": "Sanitized Company Technology Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "generated_at", "scope", "redaction", "technologies", "integrations", "unknowns"],
  "properties": {
    "schema_version": { "const": 2 },
    "inventory_id": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_kind", "repository_count_band", "excluded_repository_count_band"],
      "properties": {
        "root_kind": { "const": "multi-repository" },
        "repository_count_band": { "$ref": "#/$defs/countBand" },
        "excluded_repository_count_band": { "$ref": "#/$defs/countBand" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "removed_categories"],
      "properties": {
        "confirmed": { "const": true },
        "removed_categories": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["organization", "repository-names", "filesystem-paths", "internal-urls", "customer-data", "personal-data", "secrets", "source-code", "business-domain", "vulnerability-details"]
          }
        }
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "roles", "major_families", "usage_frequency", "signals", "confidence", "stage1_subjects", "risk_flags"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "$ref": "#/$defs/id" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 80 } },
          "major_families": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/majorFamily" } },
          "usage_frequency": { "$ref": "#/$defs/frequency" },
          "signals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/signal" } },
          "confidence": { "enum": ["high", "medium", "low"] },
          "stage1_subjects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "risk_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["version-unpinned", "lock-missing", "legacy", "prerelease", "multiple-major-families", "tests-not-observed", "supply-chain-controls-not-observed"] }
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "usage_frequency", "confidence"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "relation": { "type": "string", "minLength": 3, "maxLength": 100 },
          "usage_frequency": { "$ref": "#/$defs/frequency" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 10, "maxLength": 300 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "countBand": { "enum": ["none", "1-5", "6-10", "11-25", "26-50", "51-100", "100-plus", "withheld"] },
    "frequency": { "enum": ["single", "few", "several", "common", "pervasive", "unknown"] },
    "majorFamily": { "type": "string", "pattern": "^(?:[0-9]+|unknown|legacy|current)$" },
    "signal": {
      "enum": ["dependency-manifest", "lockfile", "build-config", "container", "ci-config", "iac", "runtime-config", "source-import", "database-migration", "documentation"]
    }
  }
}
