{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/integrated-reference-system.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "status", "subject", "entry", "runtime", "test", "evidence", "scenarios", "completion_limits"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "minLength": 3}, "status": {"enum": ["bounded-integration-proof", "verified-integration-system"]}, "subject": {"type": "string", "minLength": 10}, "entry": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 3}, "test": {"type": "string", "minLength": 1}, "evidence": {"const": "artifacts/reference-system/results.json"}, "scenarios": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "patterns", "runtime_boundaries", "assertions"], "properties": {"id": {"$ref": "#/$defs/scenario"}, "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "runtime_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}}, "completion_limits": {"type": "array", "items": {"type": "string", "minLength": 20}}},
  "$defs": {"scenario": {"enum": ["normal", "boundary", "refusal", "failure", "recovery", "migration", "operations", "security", "performance", "compatibility"]}}
}
