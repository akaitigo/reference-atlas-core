{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/claim.schema.json",
  "title": "Atlas Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "atlas_id", "capability_id", "statement", "status", "source_ids", "proof_obligations"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/dottedId" },
    "atlas_id": { "$ref": "#/$defs/id" },
    "capability_id": { "$ref": "#/$defs/dottedId" },
    "statement": { "type": "string", "minLength": 30 },
    "status": { "enum": ["proposed", "accepted", "deprecated"] },
    "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } },
    "proof_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "acceptance_criteria"],
        "properties": {
          "id": { "$ref": "#/$defs/dottedId" },
          "statement": { "type": "string", "minLength": 20 },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 15 } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
  }
}
