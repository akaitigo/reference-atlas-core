{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-body-migration.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "baseline_id", "replacements"],
  "properties": {"schema_version": {"const": 1}, "baseline_id": {"$ref": "#/$defs/id"}, "replacements": {"type": "array", "items": {"type": "object", "additionalProperties": false,
    "required": ["old_anchor_id", "new_anchor_ids", "reviewer", "reviewed_at", "source_digest", "tool_digest", "execution_proof", "migration_evidence", "reason"], "properties": {
      "old_anchor_id": {"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}, "new_anchor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}},
      "reviewer": {"type": "string", "minLength": 2}, "reviewed_at": {"type": "string", "format": "date-time"}, "source_digest": {"$ref": "#/$defs/sha256"}, "tool_digest": {"$ref": "#/$defs/sha256"},
      "execution_proof": {"type": "string", "minLength": 1}, "migration_evidence": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 20}
    }}}}, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
