{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/coverage.schema.json",
  "title": "Technology Reference Atlas Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "epoch", "authority_lock_digest", "target_sets", "targets"],
  "properties": {
    "schema_version": { "const": 1 },
    "atlas_id": { "$ref": "#/$defs/id" },
    "epoch": { "$ref": "#/$defs/date" },
    "authority_lock_digest": { "$ref": "#/$defs/sha256" },
    "target_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sequence", "completion_required", "exit_criteria"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 2 },
          "sequence": { "type": "integer", "minimum": 1 },
          "completion_required": { "type": "boolean" },
          "exit_criteria": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "target_set", "kind", "requirement", "state", "rationale", "claim_ids", "evidence_ids"],
        "properties": {
          "id": { "$ref": "#/$defs/dottedId" },
          "title": { "type": "string", "minLength": 2 },
          "target_set": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["concept", "capability", "construction", "operation", "failure", "security", "performance", "compatibility", "migration", "deprecation", "skill"] },
          "requirement": { "enum": ["required", "recommended", "informative"] },
          "state": { "enum": ["missing", "planned", "partial", "covered", "excluded", "infeasible", "expired"] },
          "rationale": { "type": "string", "minLength": 20 },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dottedId" }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dottedId" }
          },
          "exclusion": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["reason", "reviewed_at"],
            "properties": {
              "reason": { "type": "string", "minLength": 20 },
              "reviewed_at": { "$ref": "#/$defs/date" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "covered" } }, "required": ["state"] },
            "then": {
              "properties": {
                "claim_ids": { "minItems": 1 },
                "evidence_ids": { "minItems": 1 }
              }
            }
          },
          {
            "if": { "properties": { "state": { "enum": ["excluded", "infeasible"] } }, "required": ["state"] },
            "then": { "required": ["exclusion"], "properties": { "exclusion": { "type": "object" } } },
            "else": { "properties": { "exclusion": { "type": "null" } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

