{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/definitive.schema.json",
  "title": "Subject Definitive Gate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "epoch", "completion_class", "authority_extraction", "authority_body_inventory", "authority_body_review", "surface_inventory", "verification_matrix", "scenario_proofs", "scenario_closure_plan", "evidence_durability", "evidence_dependency_graph", "skill_eval", "skill_router", "certificate", "historical_certificates", "reference_systems", "comparisons"],
  "properties": {
    "schema_version": { "const": 2 },
    "atlas_id": { "$ref": "#/$defs/id" },
    "epoch": { "$ref": "#/$defs/date" },
    "completion_class": { "const": "subject-definitive" },
    "surface_inventory": { "const": "surface.inventory.yaml" },
    "authority_extraction": { "const": "authority/extraction.snapshot.json" },
    "authority_body_inventory": { "const": "authority/body-inventory.snapshot.json" },
    "authority_body_review": { "const": "authority/review-queue.snapshot.json" },
    "verification_matrix": { "const": "verification.matrix.yaml" },
    "scenario_proofs": { "const": "evidence/scenarios/index.json" },
    "scenario_closure_plan": { "const": "evidence/scenarios/closure-plan.json" },
    "evidence_durability": { "const": "artifacts/pattern-scenarios/results.json" },
    "evidence_dependency_graph": { "const": "evidence/dependency-graph.json" },
    "depth_parity": { "const": "depth.parity.yaml" },
    "skill_eval": { "type": "string", "pattern": "^evals/.+\\.definitive-skill-eval\\.json$" },
    "skill_router": { "const": "evals/definitive-skill-router.json" },
    "non_regression": { "const": "non-regression.yaml" },
    "certificate": { "const": "evidence/definitive-certificate.json" },
    "historical_certificates": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["path", "classification"], "properties": { "path": { "type": "string", "pattern": "^evidence/history/.+/completion-certificate\\.json$" }, "classification": { "const": "bounded-complete" } } }
    },
    "reference_systems": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "digest", "behavior_ids"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "pattern": "^[^/].*" }, "digest": { "$ref": "#/$defs/sha256" },
        "behavior_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } }
      } }
    },
    "comparisons": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "behavior_ids", "alternatives", "evidence_ids"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "behavior_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } },
        "alternatives": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "evidence_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/dottedId" } }
      } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
