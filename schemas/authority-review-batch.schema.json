{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-review-batch.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "queue_id", "batch_id", "status", "machine_assistance", "semantic_decisions", "items"],
  "properties": {"schema_version": {"const": 1}, "queue_id": {"$ref": "#/$defs/id"}, "batch_id": {"$ref": "#/$defs/id"}, "status": {"const": "pending-human"}, "machine_assistance": {"type": "string", "minLength": 2}, "semantic_decisions": {"const": "none"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["anchor_id", "document_id", "source_ids", "locked_source_digest", "inventory_tool_digest", "review_queue_tool_digest", "locator", "locator_kind", "parent_anchor_id", "context_start", "context_end", "context_unit", "context_digest", "priority", "priority_reasons", "candidate_cluster_id", "batch_id", "state"], "properties": {
      "anchor_id": {"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}, "document_id": {"type": "string", "pattern": "^document-[a-z0-9-]+$"}, "document_url": {"type": "string", "format": "uri"}, "authority_url": {"type": "string", "format": "uri"}, "document_locator": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}}, "locked_source_digest": {"$ref": "#/$defs/sha256"}, "inventory_tool_digest": {"$ref": "#/$defs/sha256"}, "review_queue_tool_digest": {"$ref": "#/$defs/sha256"},
      "locator": {"type": "string", "minLength": 1}, "locator_kind": {"type": "string", "minLength": 1}, "raw_selector": {"type": "string", "minLength": 1}, "element_name": {"type": "string", "minLength": 1}, "semantic_kind": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "heading_level": {"type": ["integer", "null"]}, "parent_anchor_id": {"anyOf": [{"type": "string", "pattern": "^anchor-[a-z0-9-]+$"}, {"type": "null"}]}, "context_start": {"type": "integer", "minimum": 0}, "context_end": {"type": "integer", "minimum": 1}, "context_unit": {"enum": ["byte", "utf16-code-unit", "unicode-code-point"]}, "context_digest": {"$ref": "#/$defs/sha256"}, "label_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "existing_reference_edge_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}}, "existing_mapping_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}}, "priority": {"type": "integer", "minimum": 0}, "priority_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}, "candidate_cluster_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "batch_id": {"$ref": "#/$defs/id"}, "state": {"const": "pending-human"}
    }, "allOf": [{"oneOf": [{"required": ["document_url"]}, {"required": ["authority_url", "document_locator"]}]}, {"oneOf": [{"required": ["raw_selector", "element_name", "existing_mapping_candidate_ids"]}, {"required": ["semantic_kind", "tag", "heading_level", "label_digest", "existing_reference_edge_ids"]}]}]}}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "dottedId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
