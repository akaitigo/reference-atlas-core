{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/scenario-proof-row.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "atlas_id", "generated_at", "behavior_scope", "pattern_id", "target_id", "target_set", "scenario", "status", "classification", "source_bindings", "pattern_evidence", "integrated_reference", "closure", "gaps"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 3}, "atlas_id": {"$ref": "#/$defs/id"}, "generated_at": {"type": "string", "format": "date-time"},
    "behavior_scope": {"enum": ["current-domain-pattern-not-authority-atomic", "authority-derived-atomic-behavior"]}, "pattern_id": {"type": "string", "minLength": 2}, "behavior_id": {"type": "string", "minLength": 2}, "target_id": {"type": "string", "minLength": 1}, "target_set": {"type": "string", "minLength": 1}, "scenario": {"$ref": "#/$defs/scenario"}, "applicability": {"enum": ["required", "not-applicable"]},
    "status": {"enum": ["pattern-specific-gap", "bounded-capture-proof", "bounded-runtime-proof", "completion-eligible-runtime-proof", "not-applicable"]},
    "classification": {"type": "object", "additionalProperties": false, "required": ["method", "matcher_digest", "state_ids", "semantic_scope_match"], "properties": {"method": {"type": "string", "minLength": 3}, "matcher_digest": {"$ref": "#/$defs/sha256"}, "state_ids": {"type": "array", "items": {"type": "string"}}, "semantic_scope_match": {"type": "boolean"}}},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["variant_id", "path", "digest"], "properties": {"variant_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}}}},
    "pattern_evidence": {"type": "object", "additionalProperties": false, "required": ["capture_environment_identity", "capture_harness_digest", "capture_records", "benchmark_environment", "benchmark_records", "compatibility_environment", "compatibility_records"], "properties": {"capture_environment_identity": {"type": ["object", "string", "null"]}, "capture_harness_digest": {"$ref": "#/$defs/sha256"}, "capture_records": {"type": "array", "items": {"type": "object"}}, "benchmark_environment": {"type": ["object", "string", "null"]}, "benchmark_records": {"type": "array", "items": {"type": "object"}}, "compatibility_environment": {"type": ["object", "string", "null"]}, "compatibility_records": {"type": "array", "items": {"type": "object"}}}},
    "integrated_reference": {"type": "object", "additionalProperties": false, "required": ["manifest", "result", "pattern_mapped", "runtime_boundaries", "assertions", "outcome", "attempts", "trace", "screenshot"], "properties": {"manifest": {"const": "integrations/reference-system/manifest.json"}, "result": {"const": "artifacts/reference-system/results.json"}, "pattern_mapped": {"type": "boolean"}, "runtime_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "outcome": {"type": "string", "minLength": 2}, "attempts": {"type": "integer", "minimum": 1}, "trace": {"$ref": "#/$defs/artifact"}, "screenshot": {"$ref": "#/$defs/artifact"}}},
    "authority_binding": {"type": "object", "additionalProperties": false, "required": ["authority_artifact_id", "authority_surface_id", "atomic_behavior_id", "source_digest"], "properties": {"authority_artifact_id": {"type": "string", "minLength": 1}, "authority_surface_id": {"type": "string", "minLength": 1}, "atomic_behavior_id": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/sha256"}}},
    "runtime_identity": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "execution_mode", "profile", "source_digest", "harness_path", "harness_digest", "environment", "environment_digest", "artifact_path", "artifact_digest"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "execution_mode": {"enum": ["runtime", "platform"]}, "profile": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/sha256"}, "harness_path": {"type": "string", "minLength": 1}, "harness_digest": {"$ref": "#/$defs/sha256"}, "environment": {"type": "object", "minProperties": 3}, "environment_digest": {"$ref": "#/$defs/sha256"}, "artifact_path": {"type": "string", "minLength": 1}, "artifact_digest": {"$ref": "#/$defs/sha256"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["dedicated_row", "dedicated_artifact", "pattern_specific_evidence", "real_runtime_identity", "integrated_runtime_trace", "authority_atomic_behavior", "completion_eligible"], "properties": {"dedicated_row": {"type": "boolean"}, "dedicated_artifact": {"type": "boolean"}, "pattern_specific_evidence": {"type": "boolean"}, "real_runtime_identity": {"type": "boolean"}, "integrated_runtime_trace": {"type": "boolean"}, "authority_atomic_behavior": {"type": "boolean"}, "completion_eligible": {"type": "boolean"}}},
    "gaps": {"type": "array", "items": {"type": "string", "minLength": 10}}
  },
  "allOf": [{"if": {"properties": {"closure": {"properties": {"completion_eligible": {"const": true}}}}}, "then": {"required": ["behavior_id", "authority_binding", "runtime_identity", "applicability"], "properties": {"behavior_scope": {"const": "authority-derived-atomic-behavior"}, "status": {"const": "completion-eligible-runtime-proof"}, "applicability": {"const": "required"}, "gaps": {"maxItems": 0}}}}, {"if": {"properties": {"closure": {"properties": {"completion_eligible": {"const": false}}}}}, "then": {"properties": {"gaps": {"minItems": 1}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "scenario": {"enum": ["normal", "boundary", "refusal", "failure", "recovery", "migration", "operations", "security", "performance", "compatibility"]}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "action_stream": {"type": "boolean"}, "network_stream": {"type": "boolean"}, "resource_stream": {"type": "boolean"}}}}
}
