{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/evidence.schema.json",
  "title": "Atlas Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "atlas_id", "claim_ids", "kind", "producer", "command", "created_at", "environment", "source_digest", "harness_digest", "artifact", "verdict"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "atlas_id": { "$ref": "#/$defs/simpleId" },
    "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "kind": { "enum": ["test-report", "conformance", "benchmark", "capture", "trace", "log", "measurement", "attack", "recovery", "migration", "compatibility", "skill-eval", "formal-proof"] },
    "producer": { "type": "string", "minLength": 2 },
    "command": { "type": "string", "minLength": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile", "manifest_digest"],
      "properties": {
        "profile": { "enum": ["local", "container", "vm", "cluster", "simulator", "cloud-live", "hardware-in-the-loop"] },
        "manifest_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "harness_digest": { "$ref": "#/$defs/sha256" },
    "harness_path": { "type": "string", "pattern": "^[^/].*" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "media_type"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 3 },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "verdict": { "enum": ["pass", "fail", "inconclusive"] },
    "retention": { "enum": ["git", "release", "oci", "external-immutable"] }
  },
  "$defs": {
    "simpleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
