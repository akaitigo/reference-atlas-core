{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/migration.schema.json",
  "title": "Core v1 Migration Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "from", "to", "generated_at", "id_mappings", "compatibility"],
  "properties": {
    "schema_version": { "const": 1 },
    "atlas_id": { "$ref": "#/$defs/id" },
    "from": { "type": "string", "minLength": 2 },
    "to": { "const": "core-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "id_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacy_id", "target_id", "disposition"],
        "properties": {
          "legacy_id": { "type": "string", "minLength": 1 },
          "target_id": { "$ref": "#/$defs/dottedId" },
          "disposition": { "enum": ["preserved", "renamed", "split", "merged", "retired"] },
          "reason": { "type": "string", "minLength": 15 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "legacy_paths_preserved"],
      "properties": {
        "classification": { "enum": ["compatible", "additive", "breaking"] },
        "legacy_paths_preserved": { "type": "boolean" },
        "sunset_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
  }
}
