{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/scenario-closure-plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "generated_at", "status", "scope", "policy", "source_digests", "baseline", "summary", "independent_incomplete", "completed_rows", "next_tranche", "tranches", "rows"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 3}, "generated_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["incomplete", "complete"]}, "scope": {"type": "string", "minLength": 10},
    "policy": {"type": "object", "additionalProperties": false, "required": ["risk_order", "maximum_pattern_rows_per_tranche", "monotonic_addition", "mass_closure_forbidden"], "properties": {"risk_order": {"const": ["security", "refusal", "failure", "recovery", "migration", "operations", "boundary", "performance", "compatibility", "normal"]}, "maximum_pattern_rows_per_tranche": {"const": 4}, "monotonic_addition": {"const": true}, "mass_closure_forbidden": {"const": true}}},
    "source_digests": {"type": "object", "additionalProperties": false, "required": ["evidence/scenarios/index.json", "artifacts/pattern-scenarios/results.json"], "properties": {"evidence/scenarios/index.json": {"$ref": "#/$defs/sha256"}, "artifacts/pattern-scenarios/results.json": {"$ref": "#/$defs/sha256"}}},
    "baseline": {"type": "object", "additionalProperties": false, "minProperties": 4, "required": ["matrix_rows", "patterns", "scenarios"], "properties": {"matrix_rows": {"type": "integer", "minimum": 0}, "patterns": {"type": "integer", "minimum": 0}, "scenarios": {"const": 10}}, "patternProperties": {"^inherited_gap_rows_at_[a-zA-Z0-9._-]+$": {"type": "integer", "minimum": 0}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["completed_dedicated_rows", "remaining_rows", "planned_tranches", "by_scenario"], "properties": {"completed_dedicated_rows": {"type": "integer", "minimum": 0}, "remaining_rows": {"type": "integer", "minimum": 0}, "planned_tranches": {"type": "integer", "minimum": 0}, "by_scenario": {"$ref": "#/$defs/byScenario"}}},
    "independent_incomplete": {"type": "object", "additionalProperties": false, "required": ["authority_atomic_rows", "external_profiles", "agent_forward_eval"], "properties": {"authority_atomic_rows": {"type": "integer", "minimum": 0}, "external_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "agent_forward_eval": {"type": "string", "minLength": 3}}},
    "completed_rows": {"type": "array", "items": {"$ref": "#/$defs/completedRow"}}, "next_tranche": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tranche"}]}, "tranches": {"type": "array", "items": {"$ref": "#/$defs/tranche"}}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "scenario": {"enum": ["normal", "boundary", "refusal", "failure", "recovery", "migration", "operations", "security", "performance", "compatibility"]},
    "byScenario": {"type": "object", "additionalProperties": false, "required": ["security", "refusal", "failure", "recovery", "migration", "operations", "boundary", "performance", "compatibility", "normal"], "properties": {"security": {"type": "integer", "minimum": 0}, "refusal": {"type": "integer", "minimum": 0}, "failure": {"type": "integer", "minimum": 0}, "recovery": {"type": "integer", "minimum": 0}, "migration": {"type": "integer", "minimum": 0}, "operations": {"type": "integer", "minimum": 0}, "boundary": {"type": "integer", "minimum": 0}, "performance": {"type": "integer", "minimum": 0}, "compatibility": {"type": "integer", "minimum": 0}, "normal": {"type": "integer", "minimum": 0}}},
    "requiredClosure": {"type": "object", "additionalProperties": false, "required": ["drive_pattern_scenario_and_every_variant", "first_attempt_only", "retries", "dedicated_runtime_identity", "dedicated_oracle", "separate_trace_per_variant", "required_trace_streams", "separate_screenshot_per_variant", "source_and_harness_digests", "forbidden_substitutions"], "properties": {"drive_pattern_scenario_and_every_variant": {"const": true}, "first_attempt_only": {"const": true}, "retries": {"const": 0}, "dedicated_runtime_identity": {"const": true}, "dedicated_oracle": {"const": true}, "separate_trace_per_variant": {"const": true}, "required_trace_streams": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["action", "network", "resource"]}}, "separate_screenshot_per_variant": {"const": true}, "source_and_harness_digests": {"const": true}, "forbidden_substitutions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["metadata-only", "capture-reuse", "integrated-trace-reuse", "mock-or-static-runtime"]}}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["id", "pattern_id", "target_id", "scenario", "risk_rank", "proof", "variant_ids", "required_closure", "gaps"], "properties": {"id": {"type": "string", "minLength": 3}, "pattern_id": {"type": "string", "minLength": 2}, "target_id": {"type": "string", "minLength": 1}, "scenario": {"$ref": "#/$defs/scenario"}, "risk_rank": {"type": "integer", "minimum": 1, "maximum": 10}, "proof": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^evidence/scenarios/.+\\.proof\\.json$"}, "digest": {"$ref": "#/$defs/sha256"}}}, "variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "required_closure": {"$ref": "#/$defs/requiredClosure"}, "gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}}},
    "tranche": {"type": "object", "additionalProperties": false, "required": ["id", "risk_rank", "scenario", "status", "row_ids", "pattern_rows", "variant_runs", "commit_policy"], "properties": {"id": {"type": "string", "pattern": "^(security|refusal|failure|recovery|migration|operations|boundary|performance|compatibility|normal)-[0-9]{3}$"}, "risk_rank": {"type": "integer", "minimum": 1, "maximum": 10}, "scenario": {"$ref": "#/$defs/scenario"}, "status": {"const": "planned"}, "row_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}, "pattern_rows": {"type": "integer", "minimum": 1, "maximum": 4}, "variant_runs": {"type": "integer", "minimum": 1}, "commit_policy": {"const": "one-reviewed-tranche-with-non-regression-runtime-identity-and-oracle-validation"}}},
    "completedRow": {"type": "object", "additionalProperties": false, "required": ["pattern_id", "scenario", "oracle_kinds", "variant_ids", "all_first_attempt_pass", "all_trace_streams"], "properties": {"pattern_id": {"type": "string", "minLength": 2}, "scenario": {"$ref": "#/$defs/scenario"}, "oracle_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "all_first_attempt_pass": {"const": true}, "all_trace_streams": {"const": true}}}
  }
}
