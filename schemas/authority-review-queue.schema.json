{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/akaitigo/reference-atlas-core/schemas/authority-review-queue.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "generated_at", "status", "queue_id", "input_digest", "tool_digest", "decision_ledger", "body_storage", "machine_assistance", "semantic_decisions", "summary", "batches", "stale_holds"],
  "properties": {
    "schema_version": {"const": 1}, "atlas_id": {"$ref": "#/$defs/id"}, "generated_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["incomplete-human-review-required", "closed"]}, "queue_id": {"$ref": "#/$defs/id"}, "input_digest": {"$ref": "#/$defs/sha256"}, "tool_digest": {"$ref": "#/$defs/sha256"}, "decision_ledger": {"const": "authority/reviews/decisions.json"}, "body_storage": {"enum": ["digest-locator-and-offset-only", "digest-locator-and-metadata-only"]}, "machine_assistance": {"type": "string", "minLength": 2}, "semantic_decisions": {"const": "human-only"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["eligible_documents", "queued_anchors", "pending_human", "human_reviewed", "priority_counts", "candidate_clusters", "clustered_anchors", "batches", "stale_document_holds", "decisions", "included", "excluded", "merged", "split", "authority_semantics_exhaustive"], "properties": {
      "eligible_documents": {"type": "integer", "minimum": 0}, "queued_anchors": {"type": "integer", "minimum": 0}, "pending_human": {"type": "integer", "minimum": 0}, "human_reviewed": {"type": "integer", "minimum": 0}, "priority_counts": {"type": "object", "propertyNames": {"pattern": "^[0-9]+$"}, "additionalProperties": {"type": "integer", "minimum": 0}}, "candidate_clusters": {"type": "integer", "minimum": 0}, "clustered_anchors": {"type": "integer", "minimum": 0}, "batches": {"type": "integer", "minimum": 0}, "stale_document_holds": {"type": "integer", "minimum": 0}, "unavailable_document_holds": {"type": "integer", "minimum": 0}, "decisions": {"type": "integer", "minimum": 0}, "included": {"type": "integer", "minimum": 0}, "excluded": {"type": "integer", "minimum": 0}, "merged": {"type": "integer", "minimum": 0}, "split": {"type": "integer", "minimum": 0}, "deferred": {"type": "integer", "minimum": 0}, "authority_semantics_exhaustive": {"type": "boolean"}, "queue_counts_as_depth_achievement": {"const": false}
    }},
    "batches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "digest", "priority", "bucket", "items"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^authority/review-queue-draft/review-[a-z0-9-]+\\.json$"}, "digest": {"$ref": "#/$defs/sha256"}, "priority": {"type": "integer", "minimum": 0}, "semantic_kind": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "raw_selector": {"type": "string", "minLength": 1}, "bucket": {"type": "string", "pattern": "^[a-z0-9]+$"}, "items": {"type": "integer", "minimum": 1}}, "oneOf": [{"required": ["semantic_kind"]}, {"required": ["raw_selector"]}]}},
    "stale_holds": {"type": "array", "items": {"$ref": "#/$defs/staleHold"}},
    "unavailable_holds": {"type": "array", "items": {"$ref": "#/$defs/unavailableHold"}}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "dottedId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "documentBinding": {"type": "object", "properties": {"document_id": {"type": "string", "pattern": "^document-[a-z0-9-]+$"}, "document_url": {"type": "string", "format": "uri"}, "authority_url": {"type": "string", "format": "uri"}, "document_locator": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dottedId"}}, "locked_source_digest": {"$ref": "#/$defs/sha256"}, "inventory_tool_digest": {"$ref": "#/$defs/sha256"}, "review_queue_tool_digest": {"$ref": "#/$defs/sha256"}}, "oneOf": [{"required": ["document_url"]}, {"required": ["authority_url", "document_locator"]}]},
    "staleHold": {"allOf": [{"$ref": "#/$defs/documentBinding"}, {"type": "object", "additionalProperties": false, "required": ["document_id", "source_ids", "locked_source_digest", "inventory_tool_digest", "review_queue_tool_digest", "locator", "fetched_digest", "status", "reason"], "properties": {"document_id": true, "document_url": true, "authority_url": true, "document_locator": true, "source_ids": true, "locked_source_digest": true, "inventory_tool_digest": true, "review_queue_tool_digest": true, "locator": {"const": "document-root"}, "fetched_digest": {"$ref": "#/$defs/sha256"}, "status": {"const": "hold-stale-document-relock-required"}, "reason": {"const": "locked-document-body-digest-mismatch"}}}]},
    "unavailableHold": {"allOf": [{"$ref": "#/$defs/documentBinding"}, {"type": "object", "additionalProperties": false, "required": ["document_id", "authority_url", "document_locator", "source_ids", "locked_source_digest", "inventory_tool_digest", "review_queue_tool_digest", "error_digest", "status", "reason"], "properties": {"document_id": true, "document_url": true, "authority_url": true, "document_locator": true, "source_ids": true, "locked_source_digest": true, "inventory_tool_digest": true, "review_queue_tool_digest": true, "error_digest": {"$ref": "#/$defs/sha256"}, "status": {"const": "hold-unavailable-document-retrieval-required"}, "reason": {"const": "locked-document-body-unavailable"}}}]}
}}
